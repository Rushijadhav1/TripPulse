# VoyageAI - Environment Variables

# Convex (required)
CONVEX_DEPLOYMENT=           # Your Convex deployment ID (e.g., dev:your-project)
NEXT_PUBLIC_CONVEX_URL=      # Convex client URL (e.g., https://your-project.convex.cloud)
NEXT_PUBLIC_CONVEX_SITE_URL= # Convex HTTP actions site URL (e.g., https://your-project.convex.site)

# Better Auth (required)
BETTER_AUTH_SECRET=          # Random secret for session encryption
BETTER_AUTH_URL=             # Base URL of your app (http://localhost:3000 for dev)

# AI - Groq (required)
GROQ_API_KEY=                # Groq API key for AI itinerary generation

# Places - Geoapify (required)
GEOAPIFY_API_KEY=            # Geoapify API key for places data (server-side)
NEXT_PUBLIC_GEOAPIFY_API_KEY= # Same key, exposed to browser for map rendering

# Email - Resend (optional, needed for password reset)
RESEND_API_KEY=              # Resend API key for sending emails
EMAIL_FROM=                  # Sender email (e.g., VoyageAI <onboarding@resend.dev>)

# App (optional)
SITE_URL=                    # Your app's public URL
